+    /// Insert an extension using a borrowed clone of the previous value on the JVM.
+    #[cfg(target_os = "jvm")]
+    pub fn insert<T: Clone + Send + Sync + 'static>(&mut self, val: T) -> Option<T> {
+        let previous = self.get::<T>().cloned();
+        let entry = self.map.get_or_insert_with(Box::default).entry(TypeId::of::<T>());
+        match entry {
+            std::collections::hash_map::Entry::Vacant(entry) => {
+                entry.insert(Box::new(val));
+            }
+            std::collections::hash_map::Entry::Occupied(mut entry) => {
+                *entry.get_mut() = Box::new(val);
+            }
+        }
+        previous
+    }
